# All urls are absolute https, deliberately - no relative "../name" forms.
#
# A relative url resolves against the superproject's `origin`, so once this
# repo lives at github.com/jar091/openmoonray, "../rats"
# points at github.com/jar091/rats, which does not exist. Spelling every
# host out means a clone resolves the same way regardless of where the
# superproject sits or whether it was fetched over ssh or https.
#
# Two groups, and they differ in `branch` as well as in host:
#   - the github.com/jar091 forks carry the Windows/MSVC port of the
#     openmoonray-anari project (see docs/WINDOWS_PORT.md there). Their port
#     commits live on `windows-port`, NOT on `main` - `main` is the untouched
#     upstream. `branch = main` here would make
#     `git submodule update --remote` quietly roll every one of them back to
#     unported code, so the branch has to name the port branch.
#   - everything else is unmodified upstream DreamWorks code on GitHub,
#     tracking `main`.
#
# Note `branch` only affects `git submodule update --remote`; a plain
# `git submodule update` uses the gitlink SHA recorded in the superproject.
# That is exactly why a wrong value here stays invisible until it bites.

[submodule "arras/distributed/minicoord"]
	path = arras/distributed/minicoord
	url = https://github.com/OpenMoonRay/minicoord.git
	branch = main
[submodule "arras/arras4_core"]
	path = arras/arras4_core
	url = https://github.com/OpenMoonRay/arras4_core.git
	branch = main
[submodule "moonray/scene_rdl2"]
	path = moonray/scene_rdl2
	url = https://github.com/jar091/scene_rdl2.git
	branch = windows-port
[submodule "moonray/mcrt_denoise"]
	path = moonray/mcrt_denoise
	url = https://github.com/jar091/mcrt_denoise.git
	branch = windows-port
[submodule "moonray/moonray"]
	path = moonray/moonray
	url = https://github.com/jar091/moonray.git
	branch = windows-port
[submodule "moonray/moonshine"]
	path = moonray/moonshine
	url = https://github.com/jar091/moonshine.git
	branch = windows-port
[submodule "moonray/moonshine_usd"]
	path = moonray/moonshine_usd
	url = https://github.com/OpenMoonRay/moonshine_usd.git
	branch = main
[submodule "moonray/moonray_arras/mcrt_dataio"]
	path = moonray/moonray_arras/mcrt_dataio
	url = https://github.com/OpenMoonRay/mcrt_dataio.git
	branch = main
[submodule "moonray/moonray_arras/mcrt_computation"]
	path = moonray/moonray_arras/mcrt_computation
	url = https://github.com/OpenMoonRay/mcrt_computation.git
	branch = main
[submodule "moonray/moonray_arras/mcrt_messages"]
	path = moonray/moonray_arras/mcrt_messages
	url = https://github.com/OpenMoonRay/mcrt_messages.git
	branch = main
[submodule "moonray/moonray_gui"]
	path = moonray/moonray_gui
	url = https://github.com/OpenMoonRay/moonray_gui.git
	branch = main
[submodule "moonray/hydra/hdMoonray"]
	path = moonray/hydra/hdMoonray
	url = https://github.com/OpenMoonRay/hdMoonray.git
	branch = main
[submodule "arras/arras_render"]
	path = arras/arras_render
	url = https://github.com/OpenMoonRay/arras_render.git
	branch = main
[submodule "arras/distributed/arras4_node"]
	path = arras/distributed/arras4_node
	url = https://github.com/OpenMoonRay/arras4_node.git
	branch = main
[submodule "cmake_modules"]
	path = cmake_modules
	url = https://github.com/jar091/cmake_modules.git
	branch = windows-port
[submodule "moonray/hydra/moonray_sdr_plugins"]
	path = moonray/hydra/moonray_sdr_plugins
	url = https://github.com/OpenMoonRay/moonray_sdr_plugins.git
	branch = main
# NOTE: moonray_dcc_plugins contains paths that are illegal on Windows
# (e.g. "Vop::DW_MOONRAY::AttributeMap::1.hda" - colons). Checking it out on
# Windows fails; it is not needed by this port and stays deinitialised.
[submodule "moonray/moonray_dcc_plugins"]
	path = moonray/moonray_dcc_plugins
	url = https://github.com/OpenMoonRay/moonray_dcc_plugins.git
	branch = main
[submodule "moonray/render_profile_viewer"]
	path = moonray/render_profile_viewer
	url = https://github.com/OpenMoonRay/render_profile_viewer.git
	branch = main
[submodule "rats"]
	path = rats
	url = https://github.com/OpenMoonRay/rats.git
	branch = main
[submodule "moonray/materialx_shaders"]
	path = moonray/materialx_shaders
	url = https://github.com/OpenMoonRay/materialx_shaders.git
	branch = main
